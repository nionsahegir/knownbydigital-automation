# ==========================================
# KNOWN BY DIGITAL AUTOMATION CONFIGURATION
# ==========================================

# 1. Google Gemini API (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Meta (Facebook Page & Instagram) Credentials
# Get from Meta for Developers (Graph API Explorer)
META_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# 3. Meta Threads API Credentials
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_threads_access_token_here

# 4. Storage & Retention Policy
# Keeps files for 2 days (48 hours), older files are automatically purged
RETENTION_HOURS=48

# 5. Comment Auto-Reply Interval (minutes)
COMMENT_CHECK_INTERVAL_MINUTES=15
